<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<div class="container mt-5"><div class="row justify-content-center"><div class="col-md-8 col-lg-6"><div class="card shadow-sm">
<div class="card-header bg-primary text-white"><h4 class="mb-0">Editar clientes</h4></div>
<div class="card-body">
<% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
<form action="/clientes/editar/<%= cliente.id %>" method="POST">
<div class="mb-3"><label for="nome" class="form-label">Nome</label><input class="form-control" type="text"  id="nome" name="nome" value="<%= cliente.nome %>" required></div>
<div class="mb-3"><label for="email" class="form-label">E-mail</label><input class="form-control" type="email"  id="email" name="email" value="<%= cliente.email %>" required></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-success">Salvar alterações</button><a href="/clientes" class="btn btn-secondary">Cancelar</a></div>
</form></div></div></div></div></div>
<%- include("../partials/footer") %>
